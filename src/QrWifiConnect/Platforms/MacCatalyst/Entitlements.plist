<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Sandbox MUST be disabled for CoreWLAN to join WiFi networks.
  Sandboxed apps cannot call CWInterface.associateToNetwork:password:error:
-->
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!--
	  NOTE: com.apple.developer.networking.HotspotConfiguration is an iOS-only entitlement
	  and is NOT valid on Mac Catalyst. NEHotspotConfigurationManager is available on Mac Catalyst
	  without a plist entitlement — the OS enforces access at runtime via TCC/privacy checks.
	-->
</dict>
</plist>
