<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QrWifiConnect.ViewModels"
             x:Class="QrWifiConnect.Views.ConfirmationPage"
             x:DataType="vm:ConfirmationViewModel"
             Title="Connect to Network"
             AutomationId="ConfirmationPage">

    <VerticalStackLayout
        Spacing="24"
        Padding="32"
        HorizontalOptions="Center"
        VerticalOptions="Center">

        <Label
            Text="Connect to this network?"
            FontSize="22"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            AutomationId="ConfirmationTitle"
            SemanticProperties.Description="Confirm WiFi network connection" />

        <!-- SSID -->
        <VerticalStackLayout Spacing="4">
            <Label
                Text="Network"
                FontSize="13"
                TextColor="{StaticResource Gray500}"
                AutomationId="SsidLabel" />
            <Label
                Text="{Binding Ssid}"
                FontSize="18"
                FontAttributes="Bold"
                AutomationId="SsidValue"
                SemanticProperties.Description="{Binding Ssid, StringFormat='Network name: {0}'}" />
        </VerticalStackLayout>

        <!-- Security Type -->
        <VerticalStackLayout Spacing="4">
            <Label
                Text="Security"
                FontSize="13"
                TextColor="{StaticResource Gray500}"
                AutomationId="SecurityTypeLabel" />
            <Label
                Text="{Binding SecurityType}"
                FontSize="16"
                AutomationId="SecurityTypeValue"
                SemanticProperties.Description="{Binding SecurityType, StringFormat='Security type: {0}'}" />
        </VerticalStackLayout>

        <!-- Hidden network badge -->
        <Label
            Text="Hidden Network"
            IsVisible="{Binding IsHidden}"
            FontSize="13"
            TextColor="{StaticResource Gray500}"
            AutomationId="HiddenNetworkBadge"
            SemanticProperties.Description="This is a hidden network" />

        <!-- Actions -->
        <HorizontalStackLayout
            Spacing="16"
            HorizontalOptions="Center"
            Margin="0,16,0,0">

            <Button
                Text="Cancel"
                Command="{Binding CancelCommand}"
                BackgroundColor="{StaticResource Gray200}"
                TextColor="{StaticResource Black}"
                AutomationId="CancelButton"
                SemanticProperties.Description="Cancel and return to scanner" />

            <Button
                Text="Connect"
                Command="{Binding ConnectCommand}"
                AutomationId="ConnectButton"
                SemanticProperties.Description="Connect to this WiFi network" />

        </HorizontalStackLayout>

    </VerticalStackLayout>

</ContentPage>
